# Postgres connection strings (Neon, local Postgres, or any Postgres 14+).
#
# DATABASE_URL is what the app uses. On Neon use the *pooled* connection string
# (host contains "-pooler"): serverless functions open many short-lived
# connections.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# DIRECT_URL is used only by Prisma Migrate, which needs a direct session:
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Locally both can be identical.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ajaia_docs?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/ajaia_docs?sslmode=require"
